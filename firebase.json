{
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      {
        "regex": "(?i)^/(?:test-home|style-guide|home|index(?:\\.html)?)/?$",
        "destination": "/",
        "type": 301
      },
      {
        "regex": "(?i)^/(about-us|faq|faqs)/?$",
        "destination": "/about",
        "type": 301
      },
      {
        "regex": "(?i)^/(contact-us|get-quote)/?$",
        "destination": "/contact",
        "type": 301
      },
      {
        "regex": "(?i)^/(quote|request-quote|book)/?$",
        "destination": "/#quote",
        "type": 301
      },
      {
        "regex": "(?i)^/(rentals|equipment|catalog)/?$",
        "destination": "/#rentals",
        "type": 301
      },
      {
        "regex": "(?i)^/(bundles|packages|event-bundles)/?$",
        "destination": "/#bundles",
        "type": 301
      },
      {
