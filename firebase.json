        "destination": "/services/cold-sparklers",
        "type": 301
      },
      {
        "regex": "(?i)^/(?:reviews|testimonials|gallery|equipment-list)/?$",
        "destination": "/about",
        "type": 301
      },
      {
        "regex": "(?i)^/(?:speaker-rental-boston|boston-speaker-rentals?)/?$",
