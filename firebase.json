{
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      {
        "regex": "(?i)^/(test-home|style-guide|home|index)/?$",
        "destination": "/",
        "type": 301
      },
      {
        "regex": "(?i)^/(about-us|faq|faqs)/?$",
        "destination": "/about",
        "type": 301
      },
      {
        "regex": "(?i)^/(contact-us|get-quote)/?$",
        "destination": "/contact",
        "type": 301
      },
      {
        "regex": "(?i)^/(quote|request-quote|book)/?$",
        "destination": "/#quote",
        "type": 301
      },
      {
        "regex": "(?i)^/(rentals|equipment|catalog)/?$",
        "destination": "/#rentals",
        "type": 301
      },
      {
        "regex": "(?i)^/(bundles|packages|event-bundles)/?$",
        "destination": "/#bundles",
        "type": 301
      },
      {
        "regex": "(?i)^/services/audio/?$",
        "destination": "/audio",
        "type": 301
      },
      {
        "regex": "(?i)^/services/video/?$",
        "destination": "/video",
        "type": 301
      },
      {
        "regex": "(?i)^/(?:services/)?(?:wedding|wedding-av|weddings)/?$",
        "destination": "/services/wedding-av-rentals",
        "type": 301
      },
      {
        "regex": "(?i)^/(?:services/)?(?:corporate|corporate-av)/?$",
        "destination": "/services/corporate-av-rentals",
        "type": 301
      },
      {
        "regex": "(?i)^/(?:services/)?party-speakers?/?$",
        "destination": "/services/speaker-rentals",
        "type": 301
      },
      {
        "regex": "(?i)^/(?:services/)?audiovisual-rentals?/?$",
        "destination": "/services",
        "type": 301
      },
      {
        "regex": "(?i)^/speaker-rentals?/?$",
        "destination": "/services/speaker-rentals",
        "type": 301
      },
      {
        "regex": "(?i)^/services/speaker-rental/?$",
        "destination": "/services/speaker-rentals",
        "type": 301
      },
      {
        "regex": "(?i)^/dj-equipment(?:-rentals?)?/?$",
        "destination": "/services/dj-equipment-rentals",
        "type": 301
      },
      {
        "regex": "(?i)^/services/dj-equipment(?:-rental)?/?$",
        "destination": "/services/dj-equipment-rentals",
        "type": 301
      },
      {
        "regex": "(?i)^/projector-rentals?/?$",
        "destination": "/services/projector-rentals",
        "type": 301
      },
      {
        "regex": "(?i)^/services/projector-rental/?$",
        "destination": "/services/projector-rentals",
        "type": 301
      },
      {
        "regex": "(?i)^/services/subwoofer-rental/?$",
        "destination": "/services/subwoofer-rentals",
        "type": 301
      },
      {
        "regex": "(?i)^/services/microphone-rental/?$",
        "destination": "/services/microphone-rentals",
        "type": 301
      },
      {
        "regex": "(?i)^/services/audio-mixer/?$",
        "destination": "/services/audio-mixers",
        "type": 301
      },
      {
        "regex": "(?i)^/services/tv-rental/?$",
        "destination": "/services/tv-rentals",
        "type": 301
      },
      {
        "regex": "(?i)^/services/(indoor-led-wall|led-?walls?)/?$",
        "destination": "/services/indoorledwall",
        "type": 301
      },
      {
        "regex": "(?i)^/services/(?:led-trailers?|ledtrailer)/?$",
        "destination": "/services/ledtrailers",
        "type": 301
      },
      {
        "regex": "(?i)^/services/outdoor-movie/?$",
        "destination": "/services/outdoor-movies",
        "type": 301
      },
      {
        "regex": "(?i)^/(outdoor-movies?)/?$",
        "destination": "/services/outdoor-movies",
        "type": 301
      },
      {
        "regex": "(?i)^/services/photo-booths/?$",
        "destination": "/services/photo-booth",
        "type": 301
      },
      {
        "regex": "(?i)^/photo-booths?/?$",
        "destination": "/services/photo-booth",
        "type": 301
      },
      {
        "regex": "(?i)^/silent-disco/?$",
        "destination": "/services/silent-disco",
        "type": 301
      },
      {
        "regex": "(?i)^/(?:services/)?lighting/?$",
        "destination": "/services/event-lighting",
        "type": 301
      },
      {
        "regex": "(?i)^/services/(?:special-fx|special-effects|cold-sparkler|cold-spark)/?$",
        "destination": "/services/cold-sparklers",
        "type": 301
      },
      {
        "regex": "(?i)^/(?:special-fx|special-effects|cold-sparklers?)/?$",
        "destination": "/services/cold-sparklers",
        "type": 301
      },
      {
        "regex": "(?i)^/(?:dry-ice|dry-ice-machine)/?$",
        "destination": "/services/dry-ice-machine",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=2592000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|webp|svg|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=2592000"
          }
        ]
      },
      {
        "source": "**/*.@(css|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "**/*.@(xml|txt|webmanifest)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      }
    ]
  }
}
