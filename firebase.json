        "type": 301
      },
      {
        "regex": "(?i)^/(?:audiovisual-rentals?|av-rentals?|av-equipment|audio-visual-equipment-rental)/?$",
        "destination": "/services",
        "type": 301
      },
      {
        "regex": "(?i)^/(?:hire-speakers?|guest-speaker-hire)/?$",
        "destination": "/services/speaker-rentals",
        "type": 301
      },
      {
