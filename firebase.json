      },
      {
        "regex": "(?i)^/services/projector-rental/?$",
        "destination": "/services/projector-rentals",
        "type": 301
      },
      {
        "regex": "(?i)^/subwoofer-rentals?/?$",
        "destination": "/services/subwoofer-rentals",
        "type": 301
      },
      {
        "regex": "(?i)^/services/subwoofer-rental/?$",
        "destination": "/services/subwoofer-rentals",
        "type": 301
      },
      {
        "regex": "(?i)^/(?:microphone-rental|services/microphone-rentals?)/?$",
        "destination": "/microphone-rentals",
        "type": 301
      },
      {
        "regex": "(?i)^/(?:push-to-talk-mic|wireless-mics?|wireless-microphones?|conference-mics?)/?$",
        "destination": "/microphone-rentals",
        "type": 301
      },
      {
        "regex": "(?i)^/audio-mixers?/?$",
        "destination": "/services/audio-mixers",
        "type": 301
      },
      {
        "regex": "(?i)^/services/audio-mixer/?$",
        "destination": "/services/audio-mixers",
        "type": 301
      },
      {
        "regex": "(?i)^/tv-rentals?/?$",
        "destination": "/services/tv-rentals",
        "type": 301
      },
      {
        "regex": "(?i)^/services/tv-rental/?$",
        "destination": "/services/tv-rentals",
        "type": 301
      },
      {
        "regex": "(?i)^/(?:indoorledwall|indoor-led-wall|led-?walls?|video-walls?)/?$",
        "destination": "/services/indoorledwall",
        "type": 301
      },
      {
        "regex": "(?i)^/services/(indoor-led-wall|led-?walls?)/?$",
