        "destination": "/services/wedding-av-rentals",
        "type": 301
      },
      {
        "regex": "(?i)^/(?:services/)?(?:cold-spark-machine-rentals?|cold-spark-rentals?)/?$",
        "destination": "/services/cold-sparklers",
        "type": 301
      },
      {
        "regex": "(?i)^/(?:services/)?(?:dry-ice-machine-rentals?|dry-ice-fog-machine-rentals?|fog-machine-rentals?|dancing-on-a-cloud(?:-rental)?)/?$",
        "destination": "/services/dry-ice-machine",
        "type": 301
      },
      {
        "regex": "(?i)^/(?:services/)?outdoor-movie-screen-rentals?/?$",
        "destination": "/services/outdoor-movies",
        "type": 301
      },
      {
        "regex": "(?i)^/(?:services/)?photo-booth-rentals?/?$",
        "destination": "/services/photo-booth",
        "type": 301
      },
      {
        "regex": "(?i)^/(?:services/)?silent-disco-rentals?/?$",
        "destination": "/services/silent-disco",
        "type": 301
      },
      {
        "regex": "(?i)^/(?:corporate-events?|corporate-av|corporate-event-av|corporate-meetings(?:-av)?|corporate-av-boston|corporate-meetings-av-support)/?$",
        "destination": "/services/corporate-events",
        "type": 301
      },
      {
        "regex": "(?i)^/(?:services/(?:corporate-event|corporate-av|corporate-event-av|corporate-meetings(?:-av)?)|service/corporate-events?|conference-room-sound-systems?(?:-in-ma)?)/?$",
        "destination": "/services/corporate-events",
        "type": 301
      },
      {
        "regex": "(?i)^/(?:services/)?(?:behringer-x32-rentals?|x32-rentals?|x32-mixer-rentals?|allen-heath-sq7-rentals?)/?$",
        "destination": "/services/audio-mixers",
        "type": 301
      },
      {
        "regex": "(?i)^/(?:audiovisual-rentals?|av-rentals?|av-rental-boston|boston-av-rental|av-equipment|audio-visual-equipment-rentals?(?:-services?)?|event-equipment-rentals?(?:-boston(?:-ma)?)?)/?$",
        "destination": "/services",
        "type": 301
      },
      {
        "regex": "(?i)^/(?:audio-system-rentals?|sound-equipment-rentals?(?:-near-me)?|sound-equipment-in-ma|sound-system-services(?:-in-ma)?|sound-system-rentals?(?:-for-events)?|pa-system-rentals?)/?$",
        "destination": "/audio",
        "type": 301
      },
      {
        "regex": "(?i)^/(?:party-speaker-rentals?|rent-party-speakers(?:-near-me)?)/?$",
        "destination": "/services/speaker-rentals",
        "type": 301
      },
      {
        "regex": "(?i)^/(?:rhode-island(?:-av-rentals?)?|ri-av-rentals?|providence-(?:av|speaker)-rentals?|services/ri-av-rentals?)/?$",
        "destination": "/services/rhode-island-av-rentals",
        "type": 301
      },
      {
        "regex": "(?i)^/(?:dry-ice|dry-ice-machine)/?$",
        "destination": "/services/dry-ice-machine",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Content-Language",
            "value": "en-US"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=2592000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|webp|svg|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=2592000"
          }
        ]
      },
      {
        "source": "**/*.@(css|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "**/*.@(xml|txt|webmanifest)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      }
    ]
  }
}
